:root {
    --SecondaryColor: antiquewhite;
    --textColor: rgb(54, 53, 61);
}

.footer {
    position: relative;
    padding-top: 2rem;
    padding-bottom: 4rem;
    
    .iconDiv{
        justify-content: center;
        gap: 1rem;
        bottom: 0;

        .instagram {
            font-size: 2.5rem;
        }

        .youtube {
            font-size: 2.75rem;
        }
    }
    
    .copyRight {
        justify-content: center;
        align-items: center;
        padding-top: 1rem;
    }
}